# Copy this file to `.env.local` and fill in the real links/addresses.
# Only NEXT_PUBLIC_* values are exposed to the browser, which is what we want:
# this site has no backend and no secrets.

# Google Calendar -> Appointment scheduling -> "Share" -> embed URL.
# It usually looks like:
# https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true
NEXT_PUBLIC_GOOGLE_BOOKING_EMBED_URL=""

# Public booking page URL, used for the "open in a new tab" link.
# https://calendar.app.google/XXXX
NEXT_PUBLIC_GOOGLE_BOOKING_URL=""

# Contact / social links shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL="hello@cdtattoos.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/"

# Client payment page (/client). Handles fall back to placeholder accounts
# until the real ones are set up. Links are derived from the handles unless
# the explicit URLs are provided.
NEXT_PUBLIC_VENMO_HANDLE=""
NEXT_PUBLIC_CASHAPP_HANDLE=""
NEXT_PUBLIC_APPLE_PAY_HANDLE=""
NEXT_PUBLIC_VENMO_URL=""
NEXT_PUBLIC_CASHAPP_URL=""

# Booking form endpoint (e.g., Formspree, Getform, Basin, Web3Forms)
# Leave empty to disable form submission
NEXT_PUBLIC_BOOKING_FORM_ENDPOINT=""
# Artist email for fallback/contact
NEXT_PUBLIC_BOOKING_ARTIST_EMAIL=""
